;;; init-beagrep-fix.el --- Force fix for grep-func-call
(defun grep-func-call-jump-direct ()
  "Direct jump for grep-func-call."
  (interactive)
  (let ((line (buffer-substring-no-properties
                (line-beginning-position)
                (line-end-position))))
    (when (string-match "^\\([A-Za-z0-9_.-]+\\.java\\):\\([0-9]+\\):" line)
      (let* ((filename (match-string 1 line))
             (line-num (string-to-number (match-string 2 line)))
             (current-dir nil))
        (save-excursion
          (when (re-search-backward "Entering directory .\\(.+\\)'" nil t)
            (setq current-dir (match-string 1))))
        (if current-dir
          (let ((full-path (expand-file-name filename current-dir)))
            (if (file-exists-p full-path)
              (progn
                (find-file-other-window full-path)
                (goto-char (point-min))
                (forward-line (1- line-num))
                (message "Jumped to %s:%d" full-path line-num))
              (message "File not found: %s" full-path)))
          (message "Could not find directory context"))))))

;; 强制在 grep-func-call buffer 中绑定按键
(defun setup-grep-func-call-keys ()
  "Setup keys for grep-func-call buffer."
  (when (string-match "\\*grep" (buffer-name))
    (local-set-key (kbd "RET") 'grep-func-call-jump-direct)
    (local-set-key (kbd "<return>") 'grep-func-call-jump-direct)
    (local-set-key (kbd "C-m") 'grep-func-call-jump-direct)))

;; 添加到 grep-mode-hook
(add-hook 'grep-mode-hook 'setup-grep-func-call-keys)

;; 同时修改 compilation-mode-hook（grep-mode 基于此）
(add-hook 'compilation-mode-hook 
          (lambda ()
            (when (string-match "\\*grep" (buffer-name))
              (local-set-key (kbd "RET") 'grep-func-call-jump-direct))))

(provide 'init-beagrep-fix)
