;;; init-beagrep-fix.el --- Complete fix for beagrep and grep-func-call

(require 'compile)
(require 'grep)

;; grep-func-call 跳转函数（已验证可工作）
(defun grep-func-call-jump ()
  "Jump for grep-func-call output."
  (interactive)
  (let ((line (buffer-substring-no-properties
                (line-beginning-position)
                (line-end-position)))
        (current-dir nil))
    (save-excursion
      (when (re-search-backward "Entering directory [`']\\(.+\\)'" nil t)
        (setq current-dir (match-string 1))))
    (when (string-match "^\\([^:]+\\):\\([0-9]+\\):" line)
      (let* ((filename (match-string 1 line))
             (line-num (string-to-number (match-string 2 line)))
             (full-path (expand-file-name filename current-dir)))
        (when (file-exists-p full-path)
          (find-file-other-window full-path)
          (goto-char (point-min))
          (forward-line (1- line-num)))))))

;; 智能跳转函数
(defun smart-grep-jump ()
  "Smart jump for grep modes."
  (interactive)
  (if (save-excursion
        (goto-char (point-min))
        (re-search-forward "^Entering directory" nil t))
    ;; 是 grep-func-call
    (grep-func-call-jump)
    ;; 是 beagrep，使用默认
    (compile-goto-error)))

;; 手动修复函数（这次确保定义了）
(defun fix-grep-keys ()
  "Manually fix grep keys in current buffer."
  (interactive)
  (if (derived-mode-p 'grep-mode)
    (progn
      (local-set-key (kbd "RET") 'smart-grep-jump)
      (local-set-key [return] 'smart-grep-jump)
      (local-set-key (kbd "C-m") 'smart-grep-jump)
      (message "Keys fixed! RET now calls smart-grep-jump"))
    (message "Not in a grep buffer")))

;; 全局快捷键
(global-set-key (kbd "C-c g f") 'fix-grep-keys)

;; 自动设置（使用 after-change-major-mode-hook 更可靠）
(defun auto-fix-grep-keys ()
  "Auto fix grep keys."
  (when (and (derived-mode-p 'grep-mode)
             (string-match "grep" (buffer-name)))
    (run-with-idle-timer 
      0.5 nil
      (lambda (buf)
        (when (buffer-live-p buf)
          (with-current-buffer buf
                               (local-set-key (kbd "RET") 'smart-grep-jump)
                               (local-set-key [return] 'smart-grep-jump)
                               (local-set-key (kbd "C-m") 'smart-grep-jump))))
      (current-buffer))))

(add-hook 'after-change-major-mode-hook 'auto-fix-grep-keys)

;; 修复 minibuffer 问题
(with-eval-after-load 'ajoke
                      (defadvice ajoke--setup-env (around fix-minibuffer activate)
                                 "Fix environment setup when in minibuffer."
                                 (if (minibufferp)
                                   (with-current-buffer (window-buffer (minibuffer-selected-window))
                                                        ad-do-it)
                                   ad-do-it)))

(provide 'init-beagrep-fix)
